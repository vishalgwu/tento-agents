# Resident OS local configuration. Copy this file to .env and replace only
# placeholder values; never commit .env or real credentials.

# Model providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Persistence and cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resident_os
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=resident-os-media
R2_ENDPOINT_URL=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Safety and orchestration behaviour
# DEMO_MODE must stay true until real outbound transports are explicitly enabled.
DEMO_MODE=true
COUNCIL_THRESHOLD=0.70
CONFIDENCE_AUTO_THRESHOLD=0.90
CONFIDENCE_ABSTAIN_THRESHOLD=0.60
MAX_GRAPH_STEPS=20
ORG_DAILY_BUDGET_USD=10.00
