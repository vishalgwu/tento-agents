# Resident OS local configuration. Copy this file to .env and replace only
# placeholder values; never commit .env or real credentials.

# Model providers
ANTHROPIC_API_KEY=
# Set an exact model ID available to your Anthropic account.
ANTHROPIC_MODEL=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Persistence and cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/resident_os
REDIS_URL=redis://localhost:56379/0
# Authenticated API requests are rate-limited per organisation/person window.
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60

# Cloudflare R2 object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=resident-os-media
R2_ENDPOINT_URL=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# API authentication verifies asymmetric user access tokens against this
# project's public JWKS. It must never use the service-role key on a user path.
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_TTL_SECONDS=300

# Web vendor links
# Server-only HMAC key for expiring `/v/[token]` job links. Generate a distinct
# high-entropy value per environment; do not expose it with NEXT_PUBLIC_.
VENDOR_LINK_SIGNING_SECRET=

# Safety and orchestration behaviour
# DEMO_MODE must stay true until real outbound transports are explicitly enabled.
DEMO_MODE=true
# The graph step cap is enforced in brain/graph/builder.py.

# Next.js server environment (copy these into apps/web/.env.local locally).
# Production must use the HTTPS origin of your separate Python container.
API_BASE_URL=http://127.0.0.1:8000

# Separate Railway background worker (one tenant per worker deployment).
WORKER_ORG_ID=
# Optional isolated PostgreSQL integration tests. Database name must end _test.
TEST_DATABASE_URL=

# Administrator connection for the explicit migration job only.
MIGRATION_DATABASE_URL=
POSTGRES_PORT=55432
REDIS_PORT=56379
